# syntax=docker/dockerfile:1
# Dev image: source is mounted at runtime, no rebuild needed for code changes
# FROM node:22
FROM ghcr.io/puppeteer/puppeteer:latest

WORKDIR /app

# # LibreOffice for /api/document/convert-to-pdf
# RUN apk add --no-cache libreoffice

ENV NPM_CONFIG_FETCH_TIMEOUT=120000
ENV NPM_CONFIG_FETCH_RETRIES=5

COPY package*.json ./
RUN npm install

# Source is mounted as volume when running. Client types are generated on start.
CMD ["sh", "-c", "npm run prisma:generate && npm run dev"]